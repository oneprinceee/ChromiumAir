# ChromiumAir GN Build Flags
# Optimized specifically for AVX2 + FMA3 processors (Intel Core i3-10100F and above)
# Base: ungoogled-chromium + Thorium performance profile

target_os="win"
target_cpu="x64"
is_official_build=true
is_debug=false
is_component_build=false
symbol_level=0
blink_symbol_level=0
v8_symbol_level=0

# Optimization & Linking
use_thin_lto=true
thin_lto_enable_optimizations=true
thin_lto_enable_cache=false
enable_stripping=true
exclude_unwind_tables=true
dcheck_always_on=false
enable_iterator_debugging=false
treat_warnings_as_errors=false
use_lld=true
is_clang=true
clang_use_chrome_plugins=false

# V8 High Performance Runtime
use_v8_context_snapshot=true
v8_enable_fast_torque=true
v8_enable_builtins_optimization=true
v8_enable_maglev=true
v8_enable_turbofan=true
v8_enable_wasm_simd256_revec=true
v8_drumbrake_bounds_checks=false

# Media, Codecs & Decoders
proprietary_codecs=true
ffmpeg_branding="Chrome"
media_use_ffmpeg=true
media_use_libvpx=true
enable_ffmpeg_video_decoders=true
rtc_use_h264=true
rtc_use_h265=true
rtc_enable_avx2=true
use_webaudio_pffft=true

# Widevine DRM
enable_widevine=true
bundle_widevine_cdm=true
enable_cdm_storage_id=true
enable_widevine_cdm_host_verification=true
ignore_missing_widevine_signing_cert=true
enable_media_drm_storage=true

# Strip bloatware & unneeded telemetry/services
chrome_pgo_phase=0
disable_fieldtrial_testing_config=true
enable_hangout_services_extension=false
enable_mdns=false
enable_remoting=false
enable_reporting=false
enable_service_discovery=false
enable_discovery=false
enable_nacl=false
enable_profiling=false
optimize_webui=true
google_api_key=""
google_default_client_id=""
google_default_client_secret=""
safe_browsing_mode=0
use_official_google_api_keys=false
use_unofficial_version_number=false
